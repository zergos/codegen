[Main]
Name=SpreadGraphics
Title=Кластер спреда
Group=Лента

[Property]
Color1=color,LightGreen
#Color2=color,Pink
ColorGray=color,LightGray
ColorX1=color,DarkGreen
#ColorX2=color,Brown
ColorX=color,White
Mode=n,1,режим (1 - средний спред\, 2 - максимальный)
Threshold=n,20,барьер отображения цвета
FontSize=n,6,размер шрифта

[Input]
tick=row
time=row

[InputPars]
Start
Size
bar

[Code]
<gvars>
string @names[];

<flow_init>
  if ($Start==0)
  {
    for (int @ii=0; @ii<ArraySize(@names); @ii++)
    {
      ObjectDelete(@names[@ii]);
      ObjectDelete(@names[@ii]+"x");
    }
  }
 
<flow_tick>
    string @name = "$name"+$tick.time+"_"+$tick.bid;
    if (ObjectFind(@name)==-1)
    {
      double @right;
      if ($tick.idx<$Size-1) @right = $time[$tick.idx+1];
      else @right = $bar.time+PeriodSeconds();
      
      ObjectCreate(@name+"x", OBJ_RECTANGLE, 0, $bar.time, $tick.bid, @right, $tick.bid+$tick.size);
      ObjectCreate(@name, OBJ_TEXT, 0, @right, $tick.bid+$tick.size);
      
      ObjectSet(@name, OBJPROP_COLOR, Black);
      ObjectSet(@name, OBJPROP_ANCHOR, ANCHOR_RIGHT_UPPER);
      
      ArrayResize(@names, ArraySize(@names)+1);
      @names[ArraySize(@names)-1] = @name;
    }
    
    <?Mode=1>
    if ($bar.volume[$bar.idx]>0) ObjectSetText(@name, MathRound($bar.spread[$bar.idx]/$bar.volume[$bar.idx]), $FontSize, "Courier New");
    </>
    <?Mode=2>
    ObjectSetText(@name, $bar.high[$bar.idx]+" ", $FontSize);//, "Courier New");
    </>
    <?Threshold>
    <?Mode=1>
    if ($bar.volume[$bar.idx]>0)
    if ($bar.spread[$bar.idx]/$bar.volume[$bar.idx]>=$Threshold)
    </>
    <?Mode=2>
    if ($bar.high[$bar.idx]>=$Threshold)
    </>
    {
      ObjectSet(@name+"x", OBJPROP_COLOR, $Color1);
      ObjectSet(@name, OBJPROP_COLOR, $ColorX);
    }
    else
    </>
    {
        ObjectSet(@name+"x", OBJPROP_COLOR, $ColorGray);
        ObjectSet(@name, OBJPROP_COLOR, $ColorX1);
    }

<deinit>
  for (int @i=0; @i<ArraySize(@names); @i++)
  {
    ObjectDelete(@names[@i]);
    ObjectDelete(@names[@i]+"x");
  }
    
[Help]
Рисование спредовых кластеров.
