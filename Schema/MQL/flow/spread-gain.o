[Main]
Name=SpreadGain
Title=Запись спреда
Group=Лента

[Property]
Symbols=s,EURUSD\,AUDUSD\,USDCAD\,USDJPY\,GBPUSD,перечень символов для записи

[Code]
<gvars>
string @snames[];
int @sids[];

<init>
  int @count = StringSplit("$Symbols", ',', @snames);
  ArrayResize(@sids, @count);

  for (int @n=0; @n<ArraySize(@snames); @n++)
  {
    int @sid = FlowSymbolID(@snames[@n]);
    if (@sid==-1)
    {
      Alert("по символу "+@snames[@n]+" котировки не пишутся");
      return (1);
    }
    @sids[@n] = @sid;
  }

<lines>
  for (int @i=0; @i<ArraySize(@snames); @i++)
  {
    string @s = @snames[@i];
    ForexAddTick(@sids[@i], MarketInfo(@s, MODE_ASK), MarketInfo(@s, MODE_BID));
  }

[Help]
Записывает в котировочную базу спреды указанных символов.
