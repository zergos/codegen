    // поиск 2-й точки для ГТ
    bool modified = false;
    bool checked = false;
    for (int bar = B2h; bar>B1; modified = true)
    {
      double price2 = HO(bar);
      
      double delta = (HO(B4h)-price2)/(B4h-bar);
      price2-=delta;
      checked = true;
      int l;
      for (l = bar-1; l>B1; l--, price2-=delta)
        if (breakout(H(l)>price2, L(l)<price2))
        {
