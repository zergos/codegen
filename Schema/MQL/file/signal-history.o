[Main]
Name=SignalReveal
Title=Раскрытие истории сигнала
Group=Файлы

[Property]
Prefix=s,"",строка с префиксом файла
Leverage=n,100,плечо
Spread=n,10,спред
SwapHour=n,0,час начисления свопа
BaseCurrency=s,"USD",базовая валюта депозита
TimeShift=n,0,добавляемые к сделкам часы

[Global]
<gvars>
struct historyTrade
{
  string symbol;
  datetime start, end;
  double open, close;
  int mode; // 0 - balance, 1 - buy, -1 - sell, -100 - other
  double lot;
  double sum;
  
  double margin;
  datetime times[];
  double equity[];
  
  int pos;
};

struct currencyChain
{
  string base;
  string symbol;
  bool reverse;
};

currencyChain curChains[];

<procs>
void preparecurChains()
{
  // заполнение ссылок на валюты
  for (int i=0; i<SymbolsTotal(false); i++)
  {
    string symbol = SymbolName(i, false);
    int mode = 0;
    if (StringSubstr(symbol,0,3)=="USD") mode = 1;
    else if (StringSubstr(symbol,3,3)=="USD") mode = -1;
    if (mode!=0)
    {
      int pos = ArraySize(curChains);
      ArrayResize(curChains, pos+1);
      curChains[pos].symbol = symbol;
      if (mode==1)
      {
        curChains[pos].base = StringSubstr(symbol,3,3);
        curChains[pos].reverse = false;
      }
      else
      {
        curChains[pos].base = StringSubstr(symbol,0,3);
        curChains[pos].reverse = true;
      }
    }
  }
}

double baseCurValue(string cur, datetime time)
{
  if (cur=="USD") return 1;
  for (int i=0; i<ArraySize(curChains); i++)
  {
    if (curChains[i].base == cur)
    {
      int shift = iBarShift(curChains[i].symbol, 1, time);
      if (shift<0)
      {
        Print("По символу "+curChains[i].symbol+" нет истории");
        return 1;
      }
      if (!curChains[i].reverse) return iClose(curChains[i].symbol, 1, shift);
      else return 1/iClose(curChains[i].symbol, 1, shift);
    }
  }
  Print("не найдена котировка по валюте "+cur);
  return 1;
}

double FileReadSum(int file)
{
  string sum = FileReadString(file);
  StringReplace(sum," ","");
  return StringToDouble(sum);
}

[Code]
<gvars>
historyTrade @trades[];

double equity[], freemargin[];
datetime times[];

<init>
  preparecurChains();

<lines>
    // чтение файла 
    
    int file = FileOpen($Prefix+".history.csv", FILE_READ|FILE_CSV|FILE_SHARE_READ|FILE_SHARE_WRITE|FILE_COMMON, ";");
    if (file==INVALID_HANDLE)
    {
      Print("Файл с историей не найден");
      return -1;
    }
    
    // пропуск заголовка
    for (int i=0; i<13; i++)
      FileReadString(file);
    
    while (!FileIsEnding(file))
    {
      int pos = ArraySize(@trades);
      ArrayResize(@trades, pos+1);
      // #1
      @trades[pos].start = FileReadDatetime(file)+$TimeShift*3600;
      // #2
      string mode = FileReadString(file);
      if (mode=="Buy") @trades[pos].mode = 1;
      else if (mode=="Sell") @trades[pos].mode = -1;
      else if (mode=="Buy Limit" || mode=="Buy Stop" || mode=="Sell Limit" || mode=="Sell Stop") @trades[pos].mode = -100;
      else @trades[pos].mode = 0;
      
      if (@trades[pos].mode == 0)
      {
        // для баланса только сумма
        for (int i=0; i<9; i++)
          FileReadString(file);
        @trades[pos].sum = FileReadSum(file);
        FileReadString(file);
        continue;
      }
      else if (@trades[pos].mode==-100)
      {
        for (int i=0; i<11; i++)
          FileReadString(file);
        continue;
      }
      
      // #3
      @trades[pos].lot = FileReadNumber(file);
      // #4
      @trades[pos].symbol = FileReadString(file);
      // #5
      double price = FileReadSum(file);
      if (price==0) // закрытая строка истории
      {
        ArrayResize(@trades, pos);
        for (int i=0; i<8; i++)
          FileReadString(file);
        continue;
      }
      @trades[pos].open = price;
      // #6,7
      FileReadString(file);
      FileReadString(file);
      // #8
      @trades[pos].end = FileReadDatetime(file)+$TimeShift*3600;
      // #9
      @trades[pos].close = FileReadSum(file);
      // #10,11,12
      double sum = FileReadSum(file);
      sum += FileReadSum(file);
      sum += FileReadSum(file);
      @trades[pos].sum = sum;
      // #13
      FileReadString(file);
      
      @trades[pos].pos = 0;
    }
    FileClose(file);
    
    // округление времени сделок до минутных баров
    for (int i=0; i<ArraySize(@trades); i++)
    {
      @trades[i].start = @trades[i].start/60*60;
      @trades[i].end = @trades[i].end/60*60;
    }
    
    // анализ сделок и заполнение данных
    datetime start_time=0, end_time=0;
    
    for (int i=ArraySize(@trades)-1; i>=0; i--)
    {
      if (@trades[i].mode==-100) continue;
    
      if (start_time==0 && @trades[i].mode==0) start_time = @trades[i].start;
      
      if (@trades[i].mode!=1 && @trades[i].mode!=-1) continue;
    
      double point = SymbolInfoDouble(@trades[i].symbol, SYMBOL_POINT);
      
      double baseCur = baseCurValue($BaseCurrency, trades[i].start);
      double pipCost =
        SymbolInfoDouble(trades[i].symbol, SYMBOL_TRADE_CONTRACT_SIZE)*
        baseCurValue(StringSubstr(trades[i].symbol,0,3), trades[i].start)/
        baseCurValue(StringSubstr(trades[i].symbol,3,3), trades[i].start)*
        baseCur;

      @trades[i].margin = SymbolInfoDouble(trades[i].symbol, SYMBOL_TRADE_CONTRACT_SIZE)*
        baseCurValue(StringSubstr(trades[i].symbol,0,3), trades[i].start)*
        baseCur/$Leverage;
        
      pipCost = pipCost*@trades[i].lot;
      @trades[i].margin = @trades[i].margin*@trades[i].lot;
      
      // динамический расчёт прибыли по барам
      int shift = iBarShift(@trades[i].symbol, 1, @trades[i].start);
      int shift_end = iBarShift(@trades[i].symbol, 1, @trades[i].end);
      
      if (@trades[i].end > end_time) end_time = @trades[i].end;
      
      if (shift<0)
      {
        Print("По символу ",@trades[i].symbol," нет минутной истории от ",@trades[i].start);
        return -1;
      }
      ArrayResize(@trades[i].times, shift-shift_end+1);
      ArrayResize(@trades[i].equity, shift-shift_end+1);
      for (int k=shift; k>=shift_end; k--)
      {
        @trades[i].times[shift-k] = iTime(@trades[i].symbol, 1, k);
        if (@trades[i].mode==1) // buy
          @trades[i].equity[shift-k] = (iLow(@trades[i].symbol, 1, k)-@trades[i].open-$Spread*Point)*pipCost;
        else
          @trades[i].equity[shift-k] = (@trades[i].open-iHigh(@trades[i].symbol, 1, k)-$Spread*Point)*pipCost;
        //@trades[i].mode = @trades[i].mode;
      }
      
      // добавление свопов
      double swapCost;
      if (@trades[i].mode==1) // buy
        swapCost = SymbolInfoDouble(@trades[i].symbol, SYMBOL_SWAP_LONG)*baseCur;
      else // sell
        swapCost = SymbolInfoDouble(@trades[i].symbol, SYMBOL_SWAP_SHORT)*baseCur;
      
      double swap = 0;
      for (int k=1; k<ArraySize(@trades[i].times); k++)
      {
        MqlDateTime t1,t2;
        TimeToStruct(@trades[i].times[k-1], t1);
        TimeToStruct(@trades[i].times[k], t2);
        if (t1.hour==($SwapHour+23)%24 && t2.hour==$SwapHour) swap += swapCost;
        @trades[i].equity[k] += swap;
      }
      
      @trades[i].equity[ArraySize(@trades[i].equity)-1] = @trades[i].sum;
    }
    
    // склеивание данных
    double balance = 0;
    
    int size = (end_time-start_time+1)/60;
    ArrayResize(times, size);
    ArrayResize(equity, size);
    ArrayResize(freemargin, size);
    
    datetime dt = start_time;
    int idx = -1;
    int progress = 0;
    while (dt<=end_time)
    {
      progress++;
      if (progress%10000==0) Print(dt);
      
      double extra = 0;
      double margin = 0;
      
      for (int i=ArraySize(@trades)-1; i>=0; i--)
      {
        if (@trades[i].mode==0 && @trades[i].start == dt) balance += @trades[i].sum;
        else
          if (@trades[i].mode==1 || @trades[i].mode==-1)
            if (@trades[i].end == dt) balance += @trades[i].sum;
            else
              if (dt>=@trades[i].start && dt<@trades[i].end)
              {
                while (@trades[i].pos<ArraySize(@trades[i].times) && @trades[i].times[@trades[i].pos]<dt) @trades[i].pos++;
                if (@trades[i].pos<ArraySize(@trades[i].times))
                {
                  extra += @trades[i].equity[@trades[i].pos];
                  margin += @trades[i].margin;
                }
              }
      }
      if (idx==-1 || equity[idx]!=balance+extra)
      {
        idx++;
        times[idx] = dt;
        equity[idx] = balance+extra;
        freemargin[idx] = balance+extra-margin;
      }
      dt+=60;
    }
    
    // запись данных
    // запись сделок
    int res = FileOpen($Prefix+".trades.csv", FILE_WRITE|FILE_SHARE_READ|FILE_SHARE_WRITE|FILE_CSV|FILE_COMMON, ";");
    FileWrite(res, ArraySize(@trades));
    for (int i=ArraySize(@trades)-1; i>=0; i--)
      if (@trades[i].mode==1 || @trades[i].mode==-1)
        FileWrite(res, @trades[i].symbol, @trades[i].start, @trades[i].end, @trades[i].open, @trades[i].close, @trades[i].mode, StringFormat("%s lot %.2f sum %.2f", @trades[i].mode==1?"BUY":@"SELL", @trades[i].lot, @trades[i].sum));
      else if (@trades[i].mode==0)
        FileWrite(res, "BALANCE", @trades[i].start, @trades[i].start, @trades[i].sum, 0, 0, StringFormat("balance %.2f", @trades[i].sum));
      
    FileClose(res);
    // запись баланса и маржи
    res = FileOpen($Prefix+".reveal.csv", FILE_WRITE|FILE_SHARE_READ|FILE_SHARE_WRITE|FILE_CSV|FILE_COMMON, ";");
    FileWrite(res, idx+1);
    for (int i=0; i<=idx; i++)
      FileWrite(res, times[i], StringFormat("%.2f",equity[i]), StringFormat("%.2f",freemargin[i]));
    FileClose(res);
    
[Help]
Анализирует историю сигнала и извлекает все ключевые характеристики.

