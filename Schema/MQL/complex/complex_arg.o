[Main]
Name=CArg
Group=Арифметика
Title=Аргумент (комплексные)

[Input]
cin=row

[Output]
out=row

[InputPars]
Size

[OutputPars]
Size=($Size/2)

[Code]
<gvars>
double $out[];

<lines>
  ArrayInit($out, $Size/2);
  for (int @n=0; @n<$Size; @n+=2)
    if ($cin[@n]>0)
      $out[@n>>1] = MathArctan($cin[@n+1]/$cin[@n]);
    else
      $out[@n>>1] = 0;
