[Main]
Name=CAbs
Group=Арифметика
Title=Абс. (комплексные)

[Input]
cin=row

[Output]
out=row

[InputPars]
Size

[OutputPars]
Size=($Size/2)

[Code]
<gvars>
double $out[];

<lines>
  ArrayInit($out, $Size/2);
  for (int @n=0; @n<$Size; @n+=2)
    $out[@n>>1] = MathSqrt($cin[@n]*$cin[@n] + $cin[@n+1]*$cin[@n+1]);
