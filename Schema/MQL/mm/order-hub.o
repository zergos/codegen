[Main]
Choice
Name=OrderHub
Title=Хаб
Group=Сделки

[Uses]
mm\hub-common

[Property]
MAGIC=n,1,волшебное число
Slippage=n,3,проскальзывание
LotsPerThousand=f,1,пропорция лот на тысячу баланса
NormMode=n,0,режим нормирования лота 0 - к балансу\, 1 - с учётом сделок\, 2 - с учётом маржи
BalanceFit=t,,неснижаемый баланс
NormFloor=t,,округлять ордер в нижнюю сторону
ThreadsCount=t,1,количество параллельных запусков
ThreadSleep=n,_Period,расстояние в минутах до добавления новой потока
OrdersControl=t,,расширенное управление контролем ордеров (для реальной работы)
XLots=t,,расширенное управление лотностью ордеров
ClosedFirst=t,,сначала обрабатывать новые потоки
WriteLog=t,,писать лог работы в hub.log (только при отладке)
ForceDeferred=t,,принудительное открытие отложенников при раннем пробитии уровня цены
SmartDeferred=t,,менять режим отложенника при раннем проходе цены
UseSpread=n,,учитывать для отложенников и стоп-уровней спред (1 - текущий\, 2 - средний)
MaxSpread=n,20,максимальый спред
SpreadTicks=n,60,количество тиков для расчёта спреда
CloseOnExit=t,,закрывать все ордера при выходе

[Output]
initial=c
active=c
opened=c
closed=c
error=c
threads=c

[InputPars]
Trace
Sync

[OutputPars]
ThreadRepeat=@thread_repeat
Threads=$name

[Global]
<gvars>
#include "hub.mqh"

<attach>
=hub.mqh

<?debug>
<?WriteLog>int log_file;</>
</>
string hubStateNames[] = {"ОЖИДАНИЕ","ОТЛОЖЕН","ВХОД","АКТИВЕН"};
string cmdNames[] = {"BUY", "SELL", "BUY LIMIT", "SELL LIMIT", "BUY STOP", "SELL STOP", "BALANCE", "", "", "", "VIRTUAL", "VBUYLIMIT", "VSELLLIMIT", "VBUYSTOP", "VSELLSTOP"};
double min_lot;
<?UseSpread=2>
double sum_spread=0;
int n_spread=1;
</>
<?BalanceFit>
double MaxBalance;
</>

enum pendingType
{
  PT_STOP=1,
  PT_LIMIT=2
};


double MarketLot(double lot)
{
  <?LotsPerThousand>
    <?BalanceFit>
    MaxBalance = fmax(MaxBalance,
      <?NormMode=0>AccountBalance()</>
      <?NormMode=1>AccountEquity()</>
      <?NormMode=2>AccountFreeMargin()</>
      );
    return MathMax(min_lot, <?NormFloor>floor<~>round</>(lot*$LotsPerThousand*MaxBalance/1000/min_lot)*min_lot);
    <~>
    return MathMax(min_lot, <?NormFloor>floor<~>round</>(lot*$LotsPerThousand*
      <?NormMode=0>AccountBalance()</>
      <?NormMode=1>AccountEquity()</>
      <?NormMode=2>AccountFreeMargin()</>
      /1000/min_lot)*min_lot);
    </>
  <~>
    return MathMax(min_lot, <?NormFloor>floor<~>round</>(lot/min_lot)*min_lot);
  </>
}
  
double MarketLot0(double lot)
{
  <?LotsPerThousand>
    <?BalanceFit>
    MaxBalance = fmax(MaxBalance,
      <?NormMode=0>AccountBalance()</>
      <?NormMode=1>AccountEquity()</>
      <?NormMode=2>AccountFreeMargin()</>
      );
    return floor(lot*$LotsPerThousand*MaxBalance/1000/min_lot)*min_lot;
    <~>
    return floor(lot*$LotsPerThousand*
      <?NormMode=0>AccountBalance()</>
      <?NormMode=1>AccountEquity()</>
      <?NormMode=2>AccountFreeMargin()</>
      /1000/min_lot)*min_lot;
    </>
  <~>
    return MathMax(lot,min_lot);
  </>
}
double norm(double price)
{
  return NormalizeDouble(price, Digits());
}
  
double normlot(double lot)
{
  return MathMax(min_lot, round(lot/min_lot)*min_lot);
}

double ceillot(double lot)
{
  return MathMax(min_lot, ceil(lot/min_lot)*min_lot);
}

double Spread()
{
  <?!UseSpread>
  return 0;
  </>
  <?UseSpread=1>
  return <?!MaxSpread>Ask-Bid<~>MathMin(Ask-Bid, $MaxSpread)</>;
  </>
  <?UseSpread=2>
  return sum_spread/n_spread;
  </>
}
  
class CHubThread : public ChainObject
{
public:
  int MAGIC;
  CHubOrder *firstOrder;
  static int Slippage;
  hubState hub_state;
  string state_mark;
  datetime last_state_changed;
  CHubOrder *initial, *last_order;
  bool hub_activated, hub_repeat;
  bool order_error;
  int trend;
  bool stop_thread;
  <?debug><?WriteLog>int log_file;</></>
  bool invade;
    
<?debug>
  void add_log(string message)
  {
    <?WriteLog>FileWrite(log_file, TimeToStr(CurTime()), message, "ПОТОК:"+index(), "СОСТОЯНИЕ:"+hubStateNames[hub_state]," ",trend!=0?(trend>0?"+":"-"):"");
    FileFlush(log_file);</>
    Print(message+", ПОТОК:"+index()+", СОСТОЯНИЕ:"+hubStateNames[hub_state]," ",state_mark," ",trend!=0?(trend>0?"+":"-"):"");
  }
</>

  CHubOrder *NewOrder()
  {
    <?!XLots>
    return new CHubOrder(GetPointer(this));
    <~>
    return new CPAMMOrder(GetPointer(this));
    </>
  }

  <?OrdersControl>
  static bool ProcessError(int error)
  {
    switch (error)
    {
      case 4:
        Print("Торговый сервер занят. Пробуем ещё раз...");
        Sleep(3000);
        return true;
      case 6:
        Print("Нет связи с торговым сервером. Попробуем снова...");
        Sleep(3000);
        return true;
      case 128:
        Print("Истёк срок ожидания сделки. Пробуем снова...");
        return true;
      case 129:Print("Неправильная цена. Пробуем ещё раз...");
        RefreshRates();
        return true;
      case 135:Print("Цена изменилась. Пробуем ещё раз..");
        RefreshRates();
        return true;
      case 136:Print("Нет цен. Ждём новый тик..");
        while(RefreshRates()==false)
          Sleep(1000);
        return true;
      case 137:Print("Брокер занят. Пробуем ещё раз..");
        Sleep(3000);
        return true;
      case 138:Print("Поступили новые цены. Повторяем...");
        RefreshRates();
        return true;
      case 146:Print("Подсистема торговли занята. Пробуем ещё..");
        Sleep(500);
        return true;
         
      // Критические ошибки
      case  2: Print("Общая ошибка. Повторная попытка...");
        Sleep(500);
        return true;
      case  5: Print("Старая версия терминала.");
        Work=false;
        return false;
      case 64: Print("Счет заблокирован.");
        Work=false;
        return false;
      case 130:Print("Неверные уровни SL/TP");
        return false;
      case 131:Print("Неправильный объём");
        return false;      
      case 133:Print("Торговля запрещена.");
        return false;
      case 134:Print("Недостаточно денег для совершения операции.");
        return false;
      case 4109: Print("Разрешите советнику торговать :(");
        Work = false;
        return false;
      default: Print("Возникла ошибка ",error); // Другие варианты   
        return false;
    }
  }
  
  int OrderSend2(int cmd, double lots, double &price, double sl, double tp)
  {
    int ticket = -1;
    if (AccountFreeMarginCheck(Symbol(), cmd, lots)<=0)
    {
      Print("Недостаточно средств для открытия ордера");
    }
    else
    if (cmd == OP_BUY)
    {
      price = Ask;
      ticket = OrderSend(Symbol(), OP_BUY, lots, price, Slippage, sl, tp, "", MAGIC);
      while (ticket<0 && ProcessError(GetLastError()))
      {
        price = Ask;
        ticket = OrderSend(Symbol(), OP_BUY, lots, price, Slippage, sl, tp, "", MAGIC);
      }
    }
    else if (cmd == OP_SELL)
    {
      price = Bid;
      ticket = OrderSend(Symbol(), OP_SELL, lots, price, Slippage, sl, tp, "", MAGIC);
      while (ticket<0 && ProcessError(GetLastError()))
      {
        price = Bid;
        ticket = OrderSend(Symbol(), OP_SELL, lots, price, Slippage, sl, tp, "", MAGIC);
      }
    }
    else
    {
      ticket = OrderSend(Symbol(), cmd, lots, price, Slippage, sl, tp, "", MAGIC);
      while (ticket<0 && ProcessError(GetLastError()))
        ticket = OrderSend(Symbol(), cmd, lots, price, Slippage, sl, tp, "", MAGIC);
    }
    //if (ticket<0) order_error = true;
    return ticket;
  }

  int OrderSend3(int cmd, double lots, double price, double sl, double tp, string comment="") // для отложенных
  {
    int ticket = OrderSend(Symbol(), cmd, lots, price, Slippage, sl, tp, comment, MAGIC);
    <?ForceDeferred>
      if (GetLastError()=130)
        if (cmd == OP_BUYSTOP || cmd == OP_SELLLIMIT)
        {
          double level = MarketInfo(Symbol(), MODE_STOPLEVEL);          
          if (price<Ask+level) price = Ask+level;
        }
        else if (cmd == OP_SELLSTOP || cmd == OP_BUYLIMIT)
        {
          double level = MarketInfo(Symbol(), MODE_STOPLEVEL);          
          if (price>Bid-level) price = Bid-level;
        }
    </>
    while (ticket<0 && ProcessError(GetLastError()))
      ticket = OrderSend(Symbol(), cmd, lots, price, Slippage, sl, tp, comment, MAGIC);
    return ticket;
  }
  </>

  CHubOrder *OrderPending(double price, pendingType type, double lots, int sl, int tp, int expire, hubState state, bool byMarket = true, string comment="")
  {
    CHubOrder *ho = NewOrder();
    ho.lots = byMarket?MarketLot(lots):normlot(lots);
    ho.sl = sl;
    ho.tp = tp;
    ho.fsl = 0;
    ho.ftp = 0;
    ho.expire = expire==0?0:CurTime()+expire*60;
    
    if (type == PT_STOP)
    {
      if (price>=Ask)
      {
        ho.price = norm(price)+Spread();
        ho.fsl = sl==0?0:ho.price-sl*Point;
        ho.ftp = tp==0?0:ho.price+tp*Point;
        <?debug>add_log("отложенник BUY STOP по "+ho.price+" sl "+ho.fsl+" tp "+ho.ftp+" lots "+ho.lots);</>
        <?!OrdersControl>
        ho.ticket = OrderSend(Symbol(), OP_BUYSTOP, ho.lots, ho.price, Slippage, ho.fsl, ho.ftp, comment, MAGIC);
        <~>
        ho.ticket = OrderSend3(OP_BUYSTOP, ho.lots, ho.price, ho.fsl, ho.ftp, comment);
        </>
        if (ho.ticket<0) ho.cmd = OP_VBUYSTOP;
        else ho.cmd = OP_BUYSTOP;
      }
      else
      {
        ho.price = norm(price)-Spread();
        ho.fsl = sl==0?0:ho.price+sl*Point;
        ho.ftp = tp==0?0:ho.price-tp*Point;
        <?debug>add_log("отложенник SELL STOP по "+ho.price+" sl "+ho.fsl+" tp "+ho.ftp+" lots "+ho.lots);</>
        <?!OrdersControl>
        ho.ticket = OrderSend(Symbol(), OP_SELLSTOP, ho.lots, ho.price, Slippage, ho.fsl, ho.ftp, comment, MAGIC);
        <~>
        ho.ticket = OrderSend3(OP_SELLSTOP, ho.lots, ho.price, ho.fsl, ho.ftp, comment);
        </>
        if (ho.ticket<0) ho.cmd = OP_VSELLSTOP;
        else ho.cmd = OP_SELLSTOP;
      }
    }
    else if (type == PT_LIMIT)
    {
      if (price>=Ask)
      {
        ho.price = norm(price);
        ho.fsl = sl==0?0:ho.price+sl*Point;
        ho.ftp = tp==0?0:ho.price-tp*Point;
        <?debug>add_log("отложенник SELL LIMIT по "+ho.price+" sl "+ho.fsl+" tp "+ho.ftp+" lots "+ho.lots);</>
        <?!OrdersControl>
        ho.ticket = OrderSend(Symbol(), OP_SELLLIMIT, ho.lots, ho.price, Slippage, ho.fsl, ho.ftp, comment, MAGIC);//, ho.expire);
        <~>
        ho.ticket = OrderSend3(OP_SELLLIMIT, ho.lots, ho.price, ho.fsl, ho.ftp, comment);//, ho.expire);
        </>
        if (ho.ticket<0) ho.cmd = OP_VSELLLIMIT;
        else ho.cmd = OP_SELLLIMIT;
      }
      else
      {
        ho.price = norm(price);
        ho.fsl = sl==0?0:price-sl*Point;
        ho.ftp = tp==0?0:price+tp*Point;
        <?debug>add_log("отложенник BUY LIMIT по "+ho.price+" sl "+ho.fsl+" tp "+ho.ftp+" lots "+ho.lots);</>
        <?!OrdersControl>
        ho.ticket = OrderSend(Symbol(), OP_BUYLIMIT, ho.lots, ho.price, Slippage, ho.fsl, ho.ftp, comment, MAGIC);//, ho.expire);
        <~>
        ho.ticket = OrderSend3(OP_BUYLIMIT, ho.lots, ho.price, ho.fsl, ho.ftp, comment);//, ho.expire);
        </>
        if (ho.ticket<0) ho.cmd = OP_VBUYLIMIT;
        else ho.cmd = OP_BUYLIMIT;
      }
    }
    
    if (ho.ticket>=0)
    {
      ho.state = state;
      if (hub_state<state)
      {
        hub_state = state;
        hub_activated = true;
        <?debug>add_log("состояние изменилось");</>
      }
    }
  
    return ho;
  }

  CHubOrder *OrderPending(double price, pendingType type, double lots, double sl, double tp, int expire, hubState state, bool byMarket = true, string comment="")
  {
    CHubOrder *ho = NewOrder();
    ho.lots = normlot(byMarket?MarketLot(lots):lots);
    ho.expire = expire==0?0:CurTime()+expire*60;
    ho.state = state;
  
    <?SmartDeferred>
    if (tp!=0 && sl!=0)
      if (type == PT_STOP)
      {
        if ((price>=Ask && tp<sl) || (price<=Bid && tp>sl)) type = PT_LIMIT;
      }
      else
        if ((price>=Ask && tp>sl) || (price<=Bid && tp<sl)) type = PT_STOP;
    </>
  
    if (type == PT_STOP)
    {
      if (price>=Ask)
      {
        ho.price = norm(price)+Spread();
        ho.fsl = norm(sl);
        ho.ftp = norm(tp);
        <?debug>add_log("отложенник BUY STOP по "+ho.price+" sl "+ho.fsl+" tp "+ho.ftp+" lots "+ho.lots+" "+comment);</>
        <?!OrdersControl>
        ho.ticket = OrderSend(Symbol(), OP_BUYSTOP, ho.lots, ho.price, Slippage, ho.fsl, ho.ftp, comment, MAGIC);
        <~>
        ho.ticket = OrderSend3(OP_BUYSTOP, ho.lots, ho.price, ho.fsl, ho.ftp, comment);
        </>
        if (ho.ticket<0) ho.cmd = OP_VBUYSTOP;
        else ho.cmd = OP_BUYSTOP;
      }
      else
      {
        ho.price = norm(price)-Spread();
        ho.fsl = sl==0?0:norm(sl);
        ho.ftp = tp==0?0:norm(tp);
        <?debug>add_log("отложенник SELL STOP по "+ho.price+" sl "+ho.fsl+" tp "+ho.ftp+" lots "+ho.lots+" "+comment);</>
        <?!OrdersControl>
        ho.ticket = OrderSend(Symbol(), OP_SELLSTOP, ho.lots, ho.price, Slippage, ho.fsl, ho.ftp, comment, MAGIC);
        <~>
        ho.ticket = OrderSend3(OP_SELLSTOP, ho.lots, ho.price, ho.fsl, ho.ftp, comment);
        </>
        if (ho.ticket<0) ho.cmd = OP_VSELLSTOP;
        else ho.cmd = OP_SELLSTOP;
      }
    }
    else if (type == PT_LIMIT)
    {
      if (price>=Ask)
      {
        ho.price = norm(price);
        ho.fsl = sl==0?0:norm(sl);
        ho.ftp = tp==0?0:norm(tp);
        <?debug>add_log("отложенник SELL LIMIT по "+ho.price+" sl "+ho.fsl+" tp "+ho.ftp+" lots "+ho.lots+" "+comment);</>
        <?!OrdersControl>
        ho.ticket = OrderSend(Symbol(), OP_SELLLIMIT, ho.lots, ho.price, Slippage, ho.fsl, ho.ftp, comment, MAGIC);
        <~>
        ho.ticket = OrderSend3(OP_SELLLIMIT, ho.lots, ho.price, ho.fsl, ho.ftp, comment);
        </>
        if (ho.ticket<0) ho.cmd = OP_VSELLLIMIT;
        else ho.cmd = OP_SELLLIMIT;
      }
      else
      {
        ho.price = norm(price)+Spread();
        ho.fsl = norm(sl);
        ho.ftp = norm(tp);
        <?debug>add_log("отложенник BUY LIMIT по "+ho.price+" sl "+ho.fsl+" tp "+ho.ftp+" lots "+ho.lots+" "+comment);</>
        <?!OrdersControl>
        ho.ticket = OrderSend(Symbol(), OP_BUYLIMIT, ho.lots, ho.price, Slippage, ho.fsl, ho.ftp, comment, MAGIC);
        <~>
        ho.ticket = OrderSend3(OP_BUYLIMIT, ho.lots, ho.price, ho.fsl, ho.ftp, comment);
        </>
        if (ho.ticket<0) ho.cmd = OP_VBUYLIMIT;
        else ho.cmd = OP_BUYLIMIT;
      }
    }
  
    if (ho.ticket>=0)
    {
      ho.state = state;
      if (hub_state<state)
      {
        hub_state = state;
        hub_activated = true;
        <?debug>add_log("состояние изменилось");</>
      }
    }
    else
      order_error = true;
  
    return ho;
  }
  
  double HubActiveProfit()
  {
    double sum = 0;
    ForEachL(CHubOrder, ho, firstOrder)
      if (ho.state == HUB_ACTIVE && OrderSelect(ho.ticket, SELECT_BY_TICKET))
        sum += OrderProfit();
    <?debug2>
    if (sum>0)
    {
    Print("profit at ", Bid);
    ForEachL(CHubOrder, ho, firstOrder)
      if (ho.state == HUB_ACTIVE && OrderSelect(ho.ticket, SELECT_BY_TICKET))
        Print("order ",ho.ticket," profit is ",OrderProfit());
    }
    </>
    return (sum);
  }

  double HubActivePoints()
  {
    double sum = 0;
    ForEachL(CHubOrder, ho, firstOrder)
      if (ho.state == HUB_ACTIVE && OrderSelect(ho.ticket, SELECT_BY_TICKET))
        //if (OrderType() == OP_BUY)
          sum += (Bid-OrderOpenPrice())/Point*OrderLots()/min_lot;
        //else if (OrderType() == OP_SELL)
         // @sum += (Ask-OrderOpenPrice())/Point*OrderLots()/min_lot;
    <?debug2>add_log("активных пунктов "+sum);</>
    return (sum);
  }
  
  double HubProfitPoints()
  {
    double sum = 0;
    ForEachL(CHubOrder, ho, firstOrder)
      if (ho.state == HUB_ACTIVE && OrderSelect(ho.ticket, SELECT_BY_TICKET))
        if (OrderType() == OP_BUY)
          sum += (Bid-OrderOpenPrice())/Point;
        else if (OrderType() == OP_SELL)
          sum += (OrderOpenPrice()-Ask)/Point;
    <?debug2>add_log("профитных пунктов "+sum);</>
    return (sum);
  }
  
  double HubActiveLots()
  {
    double sum = 0;
    ForEachL(CHubOrder, ho, firstOrder)
      if (ho.state == HUB_ACTIVE && OrderSelect(ho.ticket, SELECT_BY_TICKET))
        sum += OrderLots();
    return sum;
  }
  
  int HubOpenCount(int state=-1)
  {
    int res = 0;
    ForEachL(CHubOrder, ho, firstOrder)
      if ((state==-1 && ho.state != HUB_CLOSED) || ho.state == state)
        res++;
    return res;
  }

  CHubThread()
  {
    MAGIC = $MAGIC;
    hub_state = HUB_CLOSED;
    hub_activated = true;
    <?debug2>Print("мин. лот: ",min_lot);</>
    add();
  }
};

int CHubThread::Slippage = $Slippage;

<init>
  min_lot = MathMax(MarketInfo(Symbol(), MODE_MINLOT), 0.01);
  
<lines>
  <?UseSpread=2>
  if (n_spread==$SpreadTicks)
    sum_spread = sum_spread*($SpreadTicks-1)/$SpreadTicks;
  else
    n_spread++;
  sum_spread += Ask-Bid;
  </>

<sync>
  <?BalanceFit>
  sync("MaxBalance", MaxBalance);
  </>
  
[Code]
<gvars>
$threads.gvars
$threads.procs

class $name : public CHubThread
{
  public:
    
  static datetime sleep_time;
  static bool repeat;
  static $name *worker;
  
$initial.gvars
$active.gvars
$opened.gvars
$closed.gvars

$initial.procs
$active.procs
$opened.procs
$closed.procs
$hubprocs

  $name()
  {
$hub_init
    add();
  }
    
  ~$name()
  {
$initial.deinit
$active.deinit
$opened.deinit
$closed.deinit
    <?CloseOnExit>
    ForEachL(CHubOrder, ho, firstOrder)
      ho.ForceClose();
    </>
    if (HasRef(firstOrder)) firstOrder.clear();
    if (first==GetPointer(this)) first = next;
  }
    
  static $name *first;
  virtual ChainObject *getFirst() { return first; }
  virtual void setFirst(ChainObject *o) { first = o; }
  
  int process()
  {
    <?debug>//add_log("process thread #"+thread_index);</>
    
    // обновление информации по отложенным и закрытым ордерам
    bool @check_closed_state = false;
    bool closed_processed = false;
    ForEachL(CHubOrder, hoc, firstOrder)
    {
      if (hoc.state==HUB_CLOSED)
      {
        hoc.Release();
        continue;
      }
      if (!OrderSelect(hoc.ticket, SELECT_BY_TICKET) || OrderCloseTime()!=0)
      {
        hoc.state = HUB_CLOSED;
        @check_closed_state = true;
        <?debug>add_log("закрыт с профитом: "+OrderProfit());</>
        
        <?closed>
        if (!closed_processed && opMARKET(OrderType()))
        {
          closed_processed = true;
          CHubOrder *order = hoc;
$closed.lines
        }
        </>
      }
    }
  
    if (stop_thread) { stop_thread = false; return 0; }
    
    // обработка истекающих ордеров
    ForEachL(CHubOrder, ho, firstOrder)
    {
      if (ho.state==HUB_CLOSED || ho.expire==0) continue;
      if (ho.expire<=CurTime())
      {
        <?debug>add_log("ордер просрочен");</>
        ho.ForceClose();
        @check_closed_state = true;
      }
    }
    
    // обработка отложенных стопов
    ForEachL(CHubOrder, ho, firstOrder)
    {
      if (ho.state==HUB_CLOSED || ho.late_stops==0) continue;
      if (ho.late_stops<=CurTime())
      {
        <?debug>add_log("установка стопов");</>
        ho.Update();
        ho.late_stops = 0;
      }
    }
  
    // исполнение отложенных ордеров
    ForEachL(CHubOrder, ho, firstOrder)
    {
      int cmd = ho.cmd;
      switch (cmd)
      {
        case OP_VBUYSTOP:
          if (Ask>=ho.price) ho.ToMarket();
          break;
        case OP_VSELLSTOP:
          if (Bid<=ho.price) ho.ToMarket();
          break;
        case OP_VBUYLIMIT:
          if (Ask<=ho.price) ho.ToMarket();
          break;
        case OP_VSELLLIMIT:
          if (Bid>=ho.price) ho.ToMarket();
          break;
        case OP_BUYSTOP:
        case OP_SELLSTOP:
        case OP_BUYLIMIT:
        case OP_SELLLIMIT:
          if (OrderSelect(ho.ticket, SELECT_BY_TICKET))
          if (opMARKET(OrderType()))
          {
            ho.cmd = OrderType();
            ho.state = HUB_ACTIVE;
            ho.expire = 0;
            <?debug2>add_log("активирован отложенник #"+ho.ticket);</>
            <?debug>add_log("ордер #"+ho.ticket+" "+cmdNames[cmd]+" открыт "+cmdNames[ho.cmd]);</>
          }
      }
      
      if (cmd!=ho.cmd && opMARKET(ho.cmd))
      {
        if (ho.signal)
        {
          trend = ho.cmd==OP_BUY?1:-1;
          initial = ho;
        }
        
        if (hub_state != HUB_ACTIVE)
        {
          hub_state = HUB_ACTIVE;
          hub_activated = true;
          <?debug>add_log("открытие отложенника изменило состояние");</>
          initial = ho;
        }
        last_order = ho;
$opened.lines
      }
    }
    
    // отработка общих состояний
$invade
  
    // проверка перехода хаба в закрытое состояние
    if (@check_closed_state && !hub_activated)
    {
      bool closed = true;
      ForEachL(CHubOrder, ho, firstOrder)
        if (ho.state != HUB_CLOSED)
        {
          closed = false;
          break;
        }
      <?debug>add_log("проверка состояния закрытия потока "+(closed?"ДА":"НЕТ"));</>
      if (closed && hub_state != HUB_CLOSED)
      {
        hub_state = HUB_CLOSED;
        hub_activated = true;
        <?debug>add_log("состояние изменилось");</>
      }
    }

    // инициация активного состояния
    while (hub_activated)
    {
      <?debug>add_log("обработка нового состояния");</>
      <?Sync>syncSave();</>
      hub_activated = false;
      last_state_changed = CurTimeTrace();
      switch (hub_state)
      {
        case HUB_CLOSED:
        {
$initial.init
$opened.init
$closed.init
        }
        case HUB_ACTIVE:																													
        {
          // активация всех инициирующих ордеров
          /*for (@i=0; @i<ArraySize(hub); @i++)
          {
            if (hub[@i].state == HUB_CLOSED) continue;
            hub[@i].state = HUB_ACTIVE;
          }*/
$active.init
          break;
        }
      }
    }
    
    // обработка состояний
    if (stop_thread) stop_thread = false;
    else
    do
    {
      hub_repeat = false;
      switch (hub_state)
      {
        <?initial>
        case HUB_CLOSED:
          state_mark = "";
        case HUB_INITIAL:
        {
$initial.lines
          break;
        }
        </>
        <?active>
        case HUB_ACTIVE:
        {
$active.lines
          break;
        }
        </>
      }
    } while (hub_repeat);

    if (order_error)
    {
$error.lines
      order_error = false;
    }
    
    return 0;
  } // process
  
  static int ActiveThreads(hubState state=-1)
  {
    int count = 0;
    ForEach($name, th)
      if (state==-1 && th.hub_state != HUB_CLOSED || th.hub_state == state) count++;
    return count;
  }

  static double ActiveProfit()
  {
    double sum = 0;
    ForEach($name, th)
      sum += th.HubActiveProfit();
    return sum;
  }

  static double LowTrend()
  {
    double minus = 0, plus = 0;
    ForEach($name, th)
      if (th.hub_state != HUB_CLOSED)
      {
        if (th.trend>0) plus += th.HubActiveProfit();
        else minus += th.HubActiveProfit();
      }
    return (plus<minus?1:-1);
  }

  static double TrendPower(double trend)
  {
    double sum = 0;
    ForEach($name, th)
      if (th.hub_state != HUB_CLOSED)
      {
        if (th.trend>0 && trend>0 || th.trend<0 && trend<0) sum += th.HubActiveProfit();
      }
    return sum;
  }

  <?Sync>
  void syncAll()
  {
    sync("hub_state", hub_state);
    sync("last_state_changed", last_state_changed);
    sync("hub_activated", hub_activated);
    sync("order_error", order_error);
    sync("trend", trend);

    if (save)
    {
      syncWrite("HUB COUNT", HasRef(firstOrder)?firstOrder.count():0);
      ForEachL(CHubOrder, ho, firstOrder)
        ho.sync();
      <?XLots>
      syncTitle("HUB LINKS");
      ForEachL(CHubOrder, ho, firstOrder)
      {
        syncWrite("src", ho.index());
        syncWrite("dest", ChainIndex(ho.linked));
      }
      </>
      syncWrite("initial", ChainIndex(initial));
      syncWrite("last_order", ChainIndex(last_order));
    }
    else
    {
      int cnt;
      syncRead("HUB COUNT", cnt);
      for (int i=0; i<cnt; i++)
      {
        CHubOrder *ho = NewOrder();
        ho.sync();
      }
      <?XLots>
      syncTitle("HUB LINKS");
      ForEachL(CHubOrder, ho, firstOrder)
      {
        CHubOrder *ho = firstOrder.byIndex(syncRead("src"));
        ho.linked = firstOrder.byIndex(syncRead("dest"));
      }
      </>
      int idx;
      syncRead("initial", idx);
      initial = firstOrder.byIndex(idx);
      syncRead("last_order", idx);
      last_order = firstOrder.byIndex(idx);
    }
$sync
  }
  </>
}; // class def

 $name *$name::first;
datetime $name::sleep_time = 0;
bool $name::repeat;
 $name *$name::worker;

<procs>

<init>
  <?debug>
  <?WriteLog>log_file = FileOpen("hub.log", FILE_WRITE|FILE_CSV|FILE_SHARE_READ|FILE_SHARE_WRITE," ");</>
  </>
  <?ThreadsCount=1>
  $name::worker = new $name();
  </>
$threads.init

<lines>
  <?Trace><?debug>if (trace_index>0) Print("запуск потоков от ",TimeToStr(CurTimeTrace()));</></>
  do
  {
    $name::repeat = false;
    <?ThreadsCount=1>
    $name::worker.process();
    <~>
    // activate worker
  
    <?ThreadSleep>
    if (RefObject::HasRef($name::worker) && $name::worker.hub_state != HUB_CLOSED)
    {
      $name::sleep_time = CurTimeTrace()+$ThreadSleep*60;
      $name::worker = NULL;
    }
    
    if (CurTimeTrace()>=$name::sleep_time)
    {
    </>
    if (!RefObject::HasRef($name::worker) || $name::worker.hub_state != HUB_CLOSED)
    {
      <?ThreadsCount>
      if (RefObject::HasRef($name::first) && $name::first.count()>=$ThreadsCount)
        $name::worker = NULL;
      else
      </>
      {
        $name::worker = new $name();
        <?debug>Print("активация потока #"+$name::worker.index());</>
        $name::worker.hub_activated = true;
      }
    }
    <?ThreadSleep>
    }
    </>
      
    <?!ClosedFirst>
    // run all active non closed
    ForEach($name, th)
      if (th.hub_state!=HUB_CLOSED)
        th.process();
    </>
    
    if (RefObject::HasRef($name::worker)) $name::worker.process();
      
    <?ClosedFirst>
    // run all active non closed
    ForEach($name, th)
      if (th.hub_state!=HUB_CLOSED)
        th.process();
    </>
    
    // clear closed
    ForEach($name, th)
      if (th.hub_state == HUB_CLOSED && th!=$name::worker)
        th.Release();
  </>
  } while ($name::repeat);
  
$threads.lines
    
<deinit>
  if (RefObject::HasRef($name::first)) $name::first.clear();
  <?debug>
  <?WriteLog>
  FileClose(log_file);
  </>
  </>
$threads.deinit

<sync>
  <?Sync>
  syncTitle("$name");
  sync("sleep_time", $name::sleep_time);
  if (save)
  {
    syncWrite("THREADS COUNT", $name::first.count());
    ForEach($name, th)
    {
      syncTitle("THREAD #"+th.index());
      th.syncAll();
    }
    if (RefObject::HasRef($name::first))
      syncWrite("Worker", RefObject::HasRef($name::worker)?$name::worker.index():0);
  }
  else
  {
    int cnt;
    syncRead("THREADS COUNT", cnt);
    for (int i=0; i<cnt; i++)
    {
      syncTitle("THREAD #"+i);
      $name *th = new $name();
      th.syncAll();
    }
    if (cnt>0)
    {
      int idx;
      syncRead("Worker", idx);
      $name::worker = $name::first.byIndex(idx);
    }
  }
  </>
    
[Help]
Хаб для работы с ордерами.\\
Порядок функционирования:\\
  - обновляется статус хаба по отложенным и закрытым ордерам
  - для каждого закрытого ордера - выполняется блок **closed** с параметром **sig** = 1, если в прибыль или -1 при убытке
  - проверяются и закрываются истекающие ордера
  - исполняются виртуальные отложенники, обновляется статус сработавших отложенников. если такие есть - хаб переходит в состояние **HUB_ACTIVE**
  - для каждого сработавшего отложенника на предыдущем шаге выполняется блок **opened**
  - проверяется, все ли открытые ранее ордера закрыты - в этом случае хаб переходит в состояние **HUB_CLOSED**
  - если хаб поменял своё состояние - выполняется а)инициализация блока **initial** в случае **HUB_CLOSED** и б)инициализация блока **active** в случае **HUB_ACTIVE**
  - выполняется блок **initial** в случае **HUB_CLOSED**, **HUB_INITIAL**
  - выполняется блок **active** в случае **HUB_ACTIVE**
Порядок функционирования потоков:\\
  - сначала активируется дополнительный хаб с состоянием **HUB_CLOSED**, в случае, если ни одного такого не активировано и прошло достаточно времени **ThreadSleep** после выхода предыдущего хаба из состояния **HUB_CLOSED**
  - срабатывают все хабы с состоянием, отличающимся от **HUB_CLOSED**
  - деактивируются все активные хабы с новым состоянием **HUB_CLOSED**, кроме одного,
  - который тут же выполняется и в случае, если он перешёл в другое состояние активируется таймер до подключения следущего закрытого хаба (1)

