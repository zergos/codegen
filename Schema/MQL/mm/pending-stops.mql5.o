[Main]
Name=PendStops
Title=Отложенные стопы
Group=Сделки

[Property]
Lots=f
SL=n
TP=n

[Code]
<lines>
  <?SL>
  CHubOrder *@ho_sl = NewOrder();
  @ho_sl.lots = $Lots;
  if (trend>0)
  {
    @ho_sl.cmd = ORDER_TYPE_SELL_STOP;
    @ho_sl.price = Symbol.Bid()-Symbol.Point()*$SL;
  }  
  else
  {
    @ho_sl.cmd = ORDER_TYPE_BUY_STOP;
    @ho_sl.price = Symbol.Ask()+Symbol.Point()*$SL;
  }
  @ho_sl.SendPending();
  </>
  <?TP>
  CHubOrder *@ho_tp = NewOrder();
  @ho_tp.lots = $Lots;
  if (trend>0)
  {
    @ho_tp.cmd = ORDER_TYPE_SELL_LIMIT;
    @ho_tp.price = Symbol.Bid()+Symbol.Point()*$TP;
  }
  else
  {
    @ho_tp.cmd = ORDER_TYPE_BUY_LIMIT;
    @ho_tp.price = Symbol.Ask()-Symbol.Point()*$TP;
  }
  @ho_tp.SendPending();
  </>
  
[Help]
Создат стоповые уровни с помощью отложенных ордеров.

