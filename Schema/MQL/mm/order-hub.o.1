  void <?!XLots>OrderForceClose<~>OrderForceClose1</>(int i, double lots=0)
  {
    lots = lots==0?hub[i].lots:normlot(lots);
    <?debug>add_log("принудительное закрытие "+lots);</>
    if (opDEFER(hub[i].cmd))
    {
      if (OrderSelect(hub[i].ticket, SELECT_BY_TICKET))
        if (OrderDelete(hub[i].ticket))
          hub[i].state = HUB_CLOSED;
    }
    else if (hub[i].cmd == OP_BUY)
    {
      if (OrderSelect(hub[i].ticket, SELECT_BY_TICKET))
      <?OrdersControl>
        if (OrderClose2(i, OP_BUY, lots))
      <~>
        if (OrderClose(hub[i].ticket, lots, Bid, Slippage))
      </>
        if (lots==hub[i].lots)
          hub[i].state = HUB_CLOSED;
        else
        {
          hub[i].lots -= lots;
          hub[i].ticket = getLastTicket();
          <?XLots>hub[i].time_stamp = CurTime();</>
        }
    }
    else if (hub[i].cmd == OP_SELL)
    {
      if (OrderSelect(hub[i].ticket, SELECT_BY_TICKET))
      <?OrdersControl>
        if (OrderClose2(i, OP_SELL, lots))
      <~>
        if (OrderClose(hub[i].ticket, lots, Ask, Slippage))
      </>
        if (lots==hub[i].lots)
          hub[i].state = HUB_CLOSED;
        else
        {
          hub[i].lots -= lots;
          hub[i].ticket = getLastTicket();
        }
    }
    else // закрытие виртуальных
      hub[i].state = HUB_CLOSED;
      
    if (hub[i].state == HUB_CLOSED)
      for (int k=0; k<ArraySize(pins); k++)
        if (pins[k]==i) pins[k] = -1;
  }

  <?XLots>
  void OrderForceClose(int i, double lots=0)
  {
    <?debug>Print("сокращение ордера на ", lots);</>
    if (lots==0)
    {
      int pos = i;
      while (pos>=0)
      {
        OrderForceClose1(i);
        pos = hub[pos].linked;
      }
    }
    else
    {
      double rest = normlot(lots);
      while (rest>0)
      {
        int prev = 0;
        int cur = i;
        while (hub[cur].linked>=0)
        {
          prev = cur;
          cur = hub[cur].linked;
        }
        if (rest>=hub[cur].lots) // ордер требуется закрыть полностью
        {
          rest -= hub[cur].lots;
          <?debug>Print("полное закрытие ордера ", hub[cur].lots, " остаток: ",rest);</>
          OrderForceClose1(cur);
          hub[prev].linked = -1;
          hub[prev].time_stamp = CurTime();
        }
        else // закрыть частично
        {
          <?debug>Print("частичное закрытие на ", rest);</>
          OrderForceClose1(cur, rest);
          rest = 0;
        }
      }
    }
  }
  </>
  
