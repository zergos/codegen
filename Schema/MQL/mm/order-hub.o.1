[Main]
Choice
Name=OrderHub
Title=Хаб
Group=Сделки

[Property]
Slippage=n,3,проскальзывание
LotsPerThousand=f,1,пропорция лот на тысячу баланса
NormMode=n,0,режим нормирования лота 0 - к балансу\, 1 - с учётом сделок\, 2 - с учётом маржи
BalanceFit=t,,неснижаемый баланс
NormFloor=t,,округлять ордер в нижнюю сторону
ThreadsCount=t,1,количество параллельных запусков
MaxThreadsCount=n,1,максимальное количество потоков
ThreadSleep=n,_Period,расстояние в минутах до добавления новой потока
OrdersControl=t,,расширенное управление контролем ордеров (для реальной работы)
XLots=t,,расширенное управление лотностью ордеров
ClosedFirst=t,,сначала обрабатывать новые потоки
WriteLog=t,,писать лог работы в hub.log (только при отладке)
ForceDeferred=t,,принудительное открытие отложенников при раннем пробитии уровня цены
SmartDeferred=t,,менять режим отложенника при раннем проходе цены
UseSpread=n,,учитывать для отложенников и стоп-уровней спред (1 - текущий\, 2 - средний)
MaxSpread=n,20,максимальый спред
SpreadTicks=n,60,количество тиков для расчёта спреда

[Output]
initial=c
active=c
opened=c
closed=c
error=c
threads=c

[InputPars]
Trace
Sync

[OutputPars]
Threads=@threads
ThreadRepeat=@thread_repeat
ThreadType=C$name

[Global]
<gvars>
#include "hub.mqh"

<attach>
=hub.mqh
#define opLIMIT(cmd) (cmd==OP_BUYLIMIT || cmd==OP_SELLLIMIT)
#define opSTOP(cmd) (cmd==OP_BUYSTOP || cmd==OP_SELLSTOP)
#define opBUY(cmd) (cmd==OP_BUY || cmd==OP_BUYSTOP || cmd==OP_BUYLIMIT || cmd==OP_VBUYSTOP || cmd==OP_VBUYLIMIT)
#define opSELL(cmd) (cmd==OP_SELL || cmd==OP_SELLSTOP || cmd==OP_SELLLIMIT || cmd==OP_VSELLSTOP || cmd==OP_VSELLLIMIT)
#define opVIRTUAL(cmd) (cmd==OP_VSELLSTOP || cmd==OP_VBUYSTOP || cmd==OP_VSELLLIMIT || cmd==OP_VBUYLIMIT || cmd==OP_VCLOSE)
#define opMARKET(cmd) (cmd==OP_BUY || cmd==OP_SELL)
#define opDEFER(cmd) (cmd==OP_BUYSTOP || cmd==OP_SELLSTOP || cmd==OP_BUYLIMIT || cmd==OP_SELLLIMIT)
#define opREAL(cmd) (opMARKET(cmd) || opDEFER(cmd))

enum specialCmd
{
  OP_VIRTUAL = 10,
  OP_VBUYLIMIT = 11,
  OP_VSELLLIMIT = 12,
  OP_VBUYSTOP = 13,
  OP_VSELLSTOP = 14,
  OP_VCLOSE = 15
};

enum hubState
{
  HUB_CLOSED = 0,
  HUB_TAIL = 1,
  HUB_INITIAL = 2,
  HUB_ACTIVE = 3
};

<?debug>
<?WriteLog>int log_file;</>
</>
string hubStateNames[] = {"ОЖИДАНИЕ","ОТЛОЖЕН","ВХОД","АКТИВЕН"};
string cmdNames[] = {"BUY", "SELL", "BUY LIMIT", "SELL LIMIT", "BUY STOP", "SELL STOP", "BALANCE", "", "", "", "VIRTUAL", "VBUYLIMIT", "VSELLLIMIT", "VBUYSTOP", "VSELLSTOP"};
double min_lot;
<?UseSpread=2>
double sum_spread=0;
int n_spread=1;
</>
<?BalanceFit>
double MaxBalance;
</>

enum deferredType
{
  DT_STOP=1,
  DT_LIMIT=2
};

struct order_hub
{
  int ticket;
  int cmd;
  double price;
  double lots;
  int sl, tp; // stop/take in points
  double fsl, ftp; //fact stop/take
  hubState state;
  datetime expire;
  datetime late_stops;
  datetime time_stamp;
  bool signal;
  <?XLots>
  int linked;
  bool primary;
  </>
};

double MarketLot(double lot)
{
  <?LotsPerThousand>
    <?BalanceFit>
    MaxBalance = fmax(MaxBalance,
      <?NormMode=0>AccountBalance()</>
      <?NormMode=1>AccountEquity()</>
      <?NormMode=2>AccountFreeMargin()</>
      );
    return MathMax(min_lot, <?NormFloor>floor<~>round</>(lot*$LotsPerThousand*MaxBalance/1000/min_lot)*min_lot);
    <~>
    return MathMax(min_lot, <?NormFloor>floor<~>round</>(lot*$LotsPerThousand*
      <?NormMode=0>AccountBalance()</>
      <?NormMode=1>AccountEquity()</>
      <?NormMode=2>AccountFreeMargin()</>
      /1000/min_lot)*min_lot);
    </>
  <~>
    return MathMax(min_lot, <?NormFloor>floor<~>round</>(lot/min_lot)*min_lot);
  </>
}
  
double MarketLot0(double lot)
{
  <?LotsPerThousand>
    <?BalanceFit>
    MaxBalance = fmax(MaxBalance,
      <?NormMode=0>AccountBalance()</>
      <?NormMode=1>AccountEquity()</>
      <?NormMode=2>AccountFreeMargin()</>
      );
    return floor(lot*$LotsPerThousand*MaxBalance/1000/min_lot)*min_lot;
    <~>
    return floor(lot*$LotsPerThousand*
      <?NormMode=0>AccountBalance()</>
      <?NormMode=1>AccountEquity()</>
      <?NormMode=2>AccountFreeMargin()</>
      /1000/min_lot)*min_lot;
    </>
  <~>
    return MathMax(lot,min_lot);
  </>
}
double norm(double price)
{
  return NormalizeDouble(price, Digits());
}
  
double normlot(double lot)
{
  return MathMax(min_lot, round(lot/min_lot)*min_lot);
}

double ceillot(double lot)
{
  return MathMax(min_lot, ceil(lot/min_lot)*min_lot);
}

double Spread()
{
  <?!UseSpread>
  return 0;
  </>
  <?UseSpread=1>
  return <?!MaxSpread>Ask-Bid<~>MathMin(Ask-Bid, $MaxSpread)</>;
  </>
  <?UseSpread=2>
  return sum_spread/n_spread;
  </>
}
  
class CHubThread
{
public:
  int thread_index;
  bool active;
  order_hub hub[];
  int Slippage;
  hubState hub_state;
  string state_mark;
  datetime last_state_changed;
  int initial, last_order;
  bool hub_activated, hub_repeat;
  bool order_error;
  double trend;
  bool stop_thread;
  int pins[];
  <?debug><?WriteLog>int log_file;</></>
    
<?debug>
  void add_log(string message)
  {
    <?WriteLog>FileWrite(log_file, TimeToStr(CurTime()), message, "ПОТОК:"+thread_index, "СОСТОЯНИЕ:"+hubStateNames[hub_state]," ",trend!=0?(trend>0?"+":"-"):"");
    FileFlush(log_file);</>
    Print(message+", ПОТОК:"+thread_index+", СОСТОЯНИЕ:"+hubStateNames[hub_state]," ",state_mark," ",trend!=0?(trend>0?"+":"-"):"");
  }
</>

  int HubFreeIndex()
  {
    int i;
    bool found = false;
    for (i=0; i<ArraySize(hub); i++)
      if (hub[i].state == HUB_CLOSED)
      {
        found = true;
        break;
      }
        
    if (!found)
    {
      i = ArraySize(hub);
      ArrayResize(hub, i+1);
    }
    
    hub[i].time_stamp = CurTime();
    hub[i].ticket = -1;
    hub[i].cmd = -1;
    hub[i].price = 0;
    hub[i].lots = 0;
    hub[i].sl = 0;
    hub[i].tp = 0;
    hub[i].fsl = 0;
    hub[i].ftp = 0;
    hub[i].state = HUB_CLOSED;
    hub[i].expire = 0;
    hub[i].signal = false;
    <?XLots>
    hub[i].primary = true;
    hub[i].linked = -1;
    </>
    
    return (i);
  }
  
  int GetPin()
  {
    for (int i=0; i<ArraySize(pins); i++)
      if (pins[i]==-1 || (pins[i]>=0 && hub[pins[i]].state == HUB_CLOSED))
      {
        pins[i] = -2;
        return i;
      }
    ArrayResize(pins, ArraySize(pins)+1);
    pins[ArraySize(pins)-1] = -2;
    return ArraySize(pins)-1;
  }

  int getLastTicket()
  {
    if (OrderSelect(OrdersTotal()-1, SELECT_BY_POS, MODE_TRADES))
      return OrderTicket();
    else
      return -1;
  }

  <?OrdersControl>
  bool ProcessError(int error)
  {
    switch (error)
    {
      case 4:
        Print("Торговый сервер занят. Пробуем ещё раз...");
        Sleep(3000);
        return true;
      case 6:
        Print("Нет связи с торговым сервером. Попробуем снова...");
        Sleep(3000);
        return true;
      case 128:
        Print("Истёк срок ожидания сделки. Пробуем снова...");
        return true;
      case 129:Print("Неправильная цена. Пробуем ещё раз...");
        RefreshRates();
        return true;
      case 135:Print("Цена изменилась. Пробуем ещё раз..");
        RefreshRates();
        return true;
      case 136:Print("Нет цен. Ждём новый тик..");
        while(RefreshRates()==false)
          Sleep(1000);
        return true;
      case 137:Print("Брокер занят. Пробуем ещё раз..");
        Sleep(3000);
        return true;
      case 138:Print("Поступили новые цены. Повторяем...");
        RefreshRates();
        return true;
      case 146:Print("Подсистема торговли занята. Пробуем ещё..");
        Sleep(500);
        return true;
         
      // Критические ошибки
      case  2: Print("Общая ошибка. Повторная попытка...");
        Sleep(500);
        return true;
      case  5: Print("Старая версия терминала.");
        Work=false;
        return false;
      case 64: Print("Счет заблокирован.");
        Work=false;
        return false;
      case 130:Print("Неверные уровни SL/TP");
        return false;
      case 131:Print("Неправильный объём");
        return false;      
      case 133:Print("Торговля запрещена.");
        return false;
      case 134:Print("Недостаточно денег для совершения операции.");
        return false;
      case 4109: Print("Разрешите советнику торговать :(");
        Work = false;
        return false;
      default: Print("Возникла ошибка ",error); // Другие варианты   
        return false;
    }
  }
  
  int OrderSend2(int cmd, double lots, double &price, double sl, double tp)
  {
    int ticket = -1;
    if (AccountFreeMarginCheck(Symbol(), cmd, lots)<=0)
    {
      Print("Недостаточно средств для открытия ордера");
    }
    else
    if (cmd == OP_BUY)
    {
      price = Ask;
      ticket = OrderSend(Symbol(), OP_BUY, lots, price, Slippage, sl, tp, "", MAGIC);
      while (ticket<0 && ProcessError(GetLastError()))
      {
        price = Ask;
        ticket = OrderSend(Symbol(), OP_BUY, lots, price, Slippage, sl, tp, "", MAGIC);
      }
    }
    else if (cmd == OP_SELL)
    {
      price = Bid;
      ticket = OrderSend(Symbol(), OP_SELL, lots, price, Slippage, sl, tp, "", MAGIC);
      while (ticket<0 && ProcessError(GetLastError()))
      {
        price = Bid;
        ticket = OrderSend(Symbol(), OP_SELL, lots, price, Slippage, sl, tp, "", MAGIC);
      }
    }
    else
    {
      ticket = OrderSend(Symbol(), cmd, lots, price, Slippage, sl, tp, "", MAGIC);
      while (ticket<0 && ProcessError(GetLastError()))
        ticket = OrderSend(Symbol(), cmd, lots, price, Slippage, sl, tp, "", MAGIC);
    }
    //if (ticket<0) order_error = true;
    return ticket;
  }

  bool OrderClose2(int idx, int cmd, double lots)
  {
    bool res = false;
    if (cmd == OP_BUY)
    {
      double price = Bid;
      res = OrderClose(hub[idx].ticket, lots, price, Slippage);
      while (!res && ProcessError(GetLastError()))
      {
        price = Bid;
        res = OrderClose(hub[idx].ticket, lots, price, Slippage);
      }
    }
    else if (cmd == OP_SELL)
    {
      double price = Ask;
      res = OrderClose(hub[idx].ticket, lots, price, Slippage);
      while (!res && ProcessError(GetLastError()))
      {
        price = Ask;
        res = OrderClose(hub[idx].ticket, lots, price, Slippage);
      }
    }
    return res;
  }

  int OrderSend3(int cmd, double lots, double price, double sl, double tp, string comment="") // для отложенных
  {
    int ticket = OrderSend(Symbol(), cmd, lots, price, Slippage, sl, tp, comment, MAGIC);
    <?ForceDeferred>
      if (GetLastError()=130)
        if (cmd == OP_BUYSTOP || cmd == OP_SELLLIMIT)
        {
          double level = MarketInfo(Symbol(), MODE_STOPLEVEL);          
          if (price<Ask+level) price = Ask+level;
        }
        else if (cmd == OP_SELLSTOP || cmd == OP_BUYLIMIT)
        {
          double level = MarketInfo(Symbol(), MODE_STOPLEVEL);          
          if (price>Bid-level) price = Bid-level;
        }
    </>
    while (ticket<0 && ProcessError(GetLastError()))
      ticket = OrderSend(Symbol(), cmd, lots, price, Slippage, sl, tp, comment, MAGIC);
    return ticket;
  }
  </>

  int OrderDeferred(double price, deferredType type, double lots, int sl, int tp, int expire, hubState state, bool byMarket = true, string comment="")
  {
    int i = HubFreeIndex();
    hub[i].lots = byMarket?MarketLot(lots):normlot(lots);
    hub[i].sl = sl;
    hub[i].tp = tp;
    hub[i].fsl = 0;
    hub[i].ftp = 0;
    hub[i].expire = expire==0?0:CurTime()+expire*60;
    
    if (type == DT_STOP)
    {
      if (price>=Ask)
      {
        hub[i].price = norm(price)+Spread();
        hub[i].fsl = sl==0?0:price-sl*Point;
        hub[i].ftp = tp==0?0:price+tp*Point;
        <?debug>add_log("отложенник BUY STOP по "+hub[i].price+" sl "+hub[i].fsl+" tp "+hub[i].ftp+" lots "+hub[i].lots);</>
        <?!OrdersControl>
        hub[i].ticket = OrderSend(Symbol(), OP_BUYSTOP, hub[i].lots, hub[i].price, Slippage, hub[i].fsl, hub[i].ftp, comment, MAGIC);
        <~>
        hub[i].ticket = OrderSend3(OP_BUYSTOP, hub[i].lots, hub[i].price, hub[i].fsl, hub[i].ftp, comment);
        </>
        if (hub[i].ticket<0) hub[i].cmd = OP_VBUYSTOP;
        else hub[i].cmd = OP_BUYSTOP;
      }
      else
      {
        hub[i].price = norm(price);
        hub[i].fsl = sl==0?0:price+sl*Point+Spread();
        hub[i].ftp = tp==0?0:price-tp*Point+Spread();
        <?debug>add_log("отложенник SELL STOP по "+hub[i].price+" sl "+hub[i].fsl+" tp "+hub[i].ftp+" lots "+hub[i].lots);</>
        <?!OrdersControl>
        hub[i].ticket = OrderSend(Symbol(), OP_SELLSTOP, hub[i].lots, hub[i].price, Slippage, hub[i].fsl, hub[i].ftp, comment, MAGIC);
        <~>
        hub[i].ticket = OrderSend3(OP_SELLSTOP, hub[i].lots, hub[i].price, hub[i].fsl, hub[i].ftp, comment);
        </>
        if (hub[i].ticket<0) hub[i].cmd = OP_VSELLSTOP;
        else hub[i].cmd = OP_SELLSTOP;
      }
    }
    else if (type == DT_LIMIT)
    {
      if (price>=Ask)
      {
        hub[i].price = norm(price);
        hub[i].fsl = sl==0?0:price+sl*Point+Spread();
        hub[i].ftp = tp==0?0:price-tp*Point+Spread();
        <?debug>add_log("отложенник SELL LIMIT по "+hub[i].price+" sl "+hub[i].fsl+" tp "+hub[i].ftp+" lots "+hub[i].lots);</>
        <?!OrdersControl>
        hub[i].ticket = OrderSend(Symbol(), OP_SELLLIMIT, hub[i].lots, hub[i].price, Slippage, hub[i].fsl, hub[i].ftp, comment, MAGIC);//, hub[i].expire);
        <~>
        hub[i].ticket = OrderSend3(OP_SELLLIMIT, hub[i].lots, hub[i].price, hub[i].fsl, hub[i].ftp, comment);//, hub[i].expire);
        </>
        if (hub[i].ticket<0) hub[i].cmd = OP_VSELLLIMIT;
        else hub[i].cmd = OP_SELLLIMIT;
      }
      else
      {
        hub[i].price = norm(price)+Spread();
        hub[i].fsl = sl==0?0:price-sl*Point;
        hub[i].ftp = tp==0?0:price+tp*Point;
        <?debug>add_log("отложенник BUY LIMIT по "+hub[i].price+" sl "+hub[i].fsl+" tp "+hub[i].ftp+" lots "+hub[i].lots);</>
        <?!OrdersControl>
        hub[i].ticket = OrderSend(Symbol(), OP_BUYLIMIT, hub[i].lots, hub[i].price, Slippage, hub[i].fsl, hub[i].ftp, comment, MAGIC);//, hub[i].expire);
        <~>
        hub[i].ticket = OrderSend3(OP_BUYLIMIT, hub[i].lots, hub[i].price, hub[i].fsl, hub[i].ftp, comment);//, hub[i].expire);
        </>
        if (hub[i].ticket<0) hub[i].cmd = OP_VBUYLIMIT;
        else hub[i].cmd = OP_BUYLIMIT;
      }
    }
    
    if (hub[i].ticket>=0)
    {
      hub[i].state = state;
      if (hub_state<state)
      {
        hub_state = state;
        hub_activated = true;
        <?debug>add_log("состояние изменилось");</>
      }
    }
  
    return (i);
  }

  int OrderDeferred(double price, deferredType type, double lots, double sl, double tp, int expire, hubState state, bool byMarket = true, string comment="")
  {
    int i = HubFreeIndex();
    hub[i].lots = normlot(byMarket?MarketLot(lots):lots);
    hub[i].expire = expire==0?0:CurTime()+expire*60;
    hub[i].state = state;
  
    <?SmartDeferred>
    if (tp!=0 && sl!=0)
      if (type == DT_STOP)
      {
        if ((price>=Ask && tp<sl) || (price<=Bid && tp>sl)) type = DT_LIMIT;
      }
      else
        if ((price>=Ask && tp>sl) || (price<=Bid && tp<sl)) type = DT_STOP;
    </>
  
    if (type == DT_STOP)
    {
      if (price>=Ask)
      {
        hub[i].price = norm(price)+Spread();
        hub[i].fsl = norm(sl);
        hub[i].ftp = norm(tp);
        <?debug>add_log("отложенник BUY STOP по "+hub[i].price+" sl "+hub[i].fsl+" tp "+hub[i].ftp+" lots "+hub[i].lots+" "+comment);</>
        <?!OrdersControl>
        hub[i].ticket = OrderSend(Symbol(), OP_BUYSTOP, hub[i].lots, hub[i].price, Slippage, hub[i].fsl, hub[i].ftp, comment, MAGIC);
        <~>
        hub[i].ticket = OrderSend3(OP_BUYSTOP, hub[i].lots, hub[i].price, hub[i].fsl, hub[i].ftp, comment);
        </>
        if (hub[i].ticket<0) hub[i].cmd = OP_VBUYSTOP;
        else hub[i].cmd = OP_BUYSTOP;
      }
      else
      {
        hub[i].price = norm(price);
        hub[i].fsl = sl==0?0:norm(sl)+Spread();
        hub[i].ftp = tp==0?0:norm(tp)+Spread();
        <?debug>add_log("отложенник SELL STOP по "+hub[i].price+" sl "+hub[i].fsl+" tp "+hub[i].ftp+" lots "+hub[i].lots+" "+comment);</>
        <?!OrdersControl>
        hub[i].ticket = OrderSend(Symbol(), OP_SELLSTOP, hub[i].lots, hub[i].price, Slippage, hub[i].fsl, hub[i].ftp, comment, MAGIC);
        <~>
        hub[i].ticket = OrderSend3(OP_SELLSTOP, hub[i].lots, hub[i].price, hub[i].fsl, hub[i].ftp, comment);
        </>
        if (hub[i].ticket<0) hub[i].cmd = OP_VSELLSTOP;
        else hub[i].cmd = OP_SELLSTOP;
      }
    }
    else if (type == DT_LIMIT)
    {
      if (price>=Ask)
      {
        hub[i].price = norm(price);
        hub[i].fsl = sl==0?0:norm(sl)+Spread();
        hub[i].ftp = tp==0?0:norm(tp)+Spread();
        <?debug>add_log("отложенник SELL LIMIT по "+hub[i].price+" sl "+hub[i].fsl+" tp "+hub[i].ftp+" lots "+hub[i].lots+" "+comment);</>
        <?!OrdersControl>
        hub[i].ticket = OrderSend(Symbol(), OP_SELLLIMIT, hub[i].lots, hub[i].price, Slippage, hub[i].fsl, hub[i].ftp, comment, MAGIC);
        <~>
        hub[i].ticket = OrderSend3(OP_SELLLIMIT, hub[i].lots, hub[i].price, hub[i].fsl, hub[i].ftp, comment);
        </>
        if (hub[i].ticket<0) hub[i].cmd = OP_VSELLLIMIT;
        else hub[i].cmd = OP_SELLLIMIT;
      }
      else
      {
        hub[i].price = norm(price)+Spread();
        hub[i].fsl = norm(sl);
        hub[i].ftp = norm(tp);
        <?debug>add_log("отложенник BUY LIMIT по "+hub[i].price+" sl "+hub[i].fsl+" tp "+hub[i].ftp+" lots "+hub[i].lots+" "+comment);</>
        <?!OrdersControl>
        hub[i].ticket = OrderSend(Symbol(), OP_BUYLIMIT, hub[i].lots, hub[i].price, Slippage, hub[i].fsl, hub[i].ftp, comment, MAGIC);
        <~>
        hub[i].ticket = OrderSend3(OP_BUYLIMIT, hub[i].lots, hub[i].price, hub[i].fsl, hub[i].ftp, comment);
        </>
        if (hub[i].ticket<0) hub[i].cmd = OP_VBUYLIMIT;
        else hub[i].cmd = OP_BUYLIMIT;
      }
    }
  
    if (hub[i].ticket>=0)
    {
      hub[i].state = state;
      if (hub_state<state)
      {
        hub_state = state;
        hub_activated = true;
        <?debug>add_log("состояние изменилось");</>
      }
    }
    else
      order_error = true;
  
    return (i);
  }
  
  void OrderDeferred(int i)
  {
    <?debug>add_log("отложенник "+cmdNames[hub[i].cmd]+" по "+hub[i].price+" sl "+hub[i].fsl+" tp "+hub[i].ftp+" lots "+hub[i].lots);</>
    <?!OrdersControl>
    hub[i].ticket = OrderSend(Symbol(), hub[i].cmd, hub[i].lots, hub[i].price, Slippage, hub[i].fsl, hub[i].ftp, "corrected", MAGIC);
    <~>
    hub[i].ticket = OrderSend3(hub[i].cmd, hub[i].lots, hub[i].price, hub[i].fsl, hub[i].ftp, "corrected");
    </>
    if (hub[i].ticket<0) order_error = true;
  }
  
  void OrderToMarket(int idx)
  {
    int cmd = hub[idx].cmd;
