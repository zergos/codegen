C$name @threads[$MaxThreadsCount];
datetime @sleep_time = 0;
bool @thread_repeat;

<procs>
int ActiveThreads(C$name &lthreads[], hubState state=-1)
{
  int count = 0;
  for (int i=0; i<ArraySize(lthreads); i++)
  {
    if (state==-1 && lthreads[i].hub_state != HUB_CLOSED || lthreads[i].hub_state == state) count++;
  }
  return count;
}

double ActiveProfit(C$name &lthreads[])
{
  double sum = 0;
  for (int i=0; i<ArraySize(lthreads); i++)
    sum += lthreads[i].HubActiveProfit();
  return sum;
}

double LowTrend(C$name &lthreads[])
{
  double minus = 0, plus = 0;
  for (int i=0; i<ArraySize(lthreads); i++)
    if (lthreads[i].hub_state != HUB_CLOSED)
    {
      if (lthreads[i].trend>0) plus += lthreads[i].HubActiveProfit();
      else minus += lthreads[i].HubActiveProfit();
    }
  return (plus<minus?1:-1);
}

double TrendPower(C$name &lthreads[], double trend)
{
  double sum = 0;
  for (int i=0; i<ArraySize(lthreads); i++)
    if (lthreads[i].hub_state != HUB_CLOSED)
    {
      if (lthreads[i].trend>0 && trend>0 || lthreads[i].trend<0 && trend<0) sum += lthreads[i].HubActiveProfit();
    }
  return sum;
}

<init>
  <?debug>
  <?WriteLog>log_file = FileOpen("hub.log", FILE_WRITE|FILE_CSV|FILE_SHARE_READ|FILE_SHARE_WRITE," ");</>
  </>
  <?ThreadsCount=1>
  @threads[0].active = true;
  <~>
  for (int @i=0; @i<$ThreadsCount; @i++)
  {
    @threads[@i].thread_index = @i;
    <?debug>
    <?WriteLog>@threads[@i].log_file = FileOpen("hub"+@i+".log", FILE_WRITE|FILE_CSV|FILE_SHARE_READ|FILE_SHARE_WRITE," ");</>
    </>
  }
  </>
$threads.init

<lines>
  <?Trace><?debug>if (trace_index>0) Print("запуск потоков от ",TimeToStr(CurTimeTrace()));</></>
  do
  {
    @thread_repeat = false;
  <?MaxThreadsCount=1>
  @threads[0].process();
  <~>
  // activate one closed on next tick
  <?!ThreadsCount=1>
  if ($ThreadsCount==1)
  {
    @threads[0].active = true;
    @threads[0].process();
  }
  else
  </>
  {
  bool @closed_found;
  <?ThreadSleep>
  if (CurTimeTrace()>=@sleep_time)
  {
  </>
    @closed_found = false;
    for (int @i=0; @i<$ThreadsCount; @i++)
      if (@threads[@i].active && @threads[@i].hub_state == HUB_CLOSED)
      {
        @closed_found = true;
        break;
      }

    if (!@closed_found)
    for (int @i=0; @i<$ThreadsCount; @i++)
      if (!@threads[@i].active)
      {
        <?debug>Print("активация потока #"+@i);</>
        @threads[@i].active = true;
        @threads[@i].hub_activated = true;
        break;
      }
   <?ThreadSleep>
   }
   </>
      
  <?!ClosedFirst>
  // run all active non closed
  for (int @i=0; @i<$ThreadsCount; @i++)
    if (@threads[@i].active && @threads[@i].hub_state!=HUB_CLOSED)
      @threads[@i].process();
  </>
      
  // deactivate all closed except one, which to process
  @closed_found = false;
  for (int @i=0; @i<$ThreadsCount; @i++)
    if (@threads[@i].active && @threads[@i].hub_state == HUB_CLOSED)
      if (!@closed_found)
      {
        @closed_found = true;
        @threads[@i].process();
        if (@threads[@i].hub_state!=HUB_CLOSED)
        {
          <?ThreadSleep>
          @sleep_time = CurTimeTrace()+$ThreadSleep*60;
          <~>
          @closed_found = false;
          </>
          <?debug>Print("поток готов к работе #",@i);</>
        }
      }
      else @threads[@i].active = false;

  <?ClosedFirst>
  // run all active non closed
  for (int @i=0; @i<$ThreadsCount; @i++)
    if (@threads[@i].active && @threads[@i].hub_state!=HUB_CLOSED)
      @threads[@i].process();
  </>
  }   
  </>
  } while (@thread_repeat);
  
$threads.lines
    
<deinit>
  <?debug>
  <?WriteLog>
  FileClose(log_file);
  for (int @i=0; @i<$ThreadsCount; @i++)
    FileClose(@threads[@i].log_file);
  </>
  </>
$threads.deinit

