            if (hub[@i].state == HUB_CLOSED) continue;
            hub[@i].state = HUB_ACTIVE;
          }*/
$active.init
          break;
        }
      }
    }
    
    // обработка состояний
    if (stop_thread) stop_thread = false;
    else
    do
    {
      hub_repeat = false;
      switch (hub_state)
      {
        <?initial>
        case HUB_CLOSED:
          state_mark = "";
        case HUB_INITIAL:
        {
$initial.lines
          break;
        }
        </>
        <?active>
        case HUB_ACTIVE:
        {
$active.lines
          break;
        }
        </>
      }
    } while (hub_repeat);

    if (order_error)
    {
$error.lines
      order_error = false;
    }
    
    return 0;
  } // process
  
  <?Sync>
  void syncAll()
  {
    sync("thread_index", thread_index);
    sync("active", active);
    int @hs = hub_state;
    sync("hub_state", @hs);
    hub_state = (hubState)@hs;
    sync("last_state_changed", last_state_changed);
    sync("initial", initial);
    sync("last_order", last_order);
    sync("hub_activated", hub_activated);
    sync("order_error", order_error);
    sync("trend", trend);

    if (save)
      FileWrite(syncFile, "hub", ArraySize(hub));
    else
    {
      FileReadString(syncFile);
      ArrayResize(hub, FileReadNumber(syncFile));
    }
    for (int @k=0; @k<ArraySize(hub); @k++)
    {
      syncTitle("HUB #"+@k);
