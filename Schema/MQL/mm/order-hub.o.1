  void OrderSetStop(int i, double level, bool only=false)
  {
    int cmd = hub[i].cmd;
    switch (cmd)
    {
      case OP_BUY:
        if (level>=Ask)
          OrderSetTP(i, level, only);
        else
          OrderSetSL(i, level, only);
        break;
        
      case OP_BUYSTOP:
      case OP_BUYLIMIT:
        if (level>=hub[i].price)
          OrderSetTP(i, level, only);
        else
          OrderSetSL(i, level, only);
        break;
          
      case OP_SELL:
        if (level<=Bid)
          OrderSetTP(i, level, only);
        else
          OrderSetSL(i, level, only);
        break;
          
      case OP_SELLSTOP:
      case OP_SELLLIMIT:
        if (level<=hub[i].price)
          OrderSetTP(i, level, only);
        else
          OrderSetSL(i, level, only);
    }
  }
  
