[Main]
Title=Генератор тиков (полный)
Group=Генераторы
Name=TickGenFull

[Property]
Shift=n,0,сдвиг

[InputPars]
Size
Trace

[Output]
OPEN=row,@zOpen
CLOSE=row,@zClose
HIGH=row,@zHigh
LOW=row,@zLow
VOLUME=row,@zVolume
TIME=row,@zTime

[OutputPars]
TimeShift=@shift
Size=<?LastTime>@tickSize<~>$Size</>

[Code]
<gvars>
int @shift;
<?LastTime>int @tickSize;</>
<?OPEN>double @zOpen[];</>
<?CLOSE>double @zClose[];</>
<?HIGH>double @zHigh[];</>
<?LOW>double @zLow[];</>
<?VOLUME>double @zVolume[];</>
<?TIME>datetime @zTime[];</>

<lines>
  <?OPEN>ArrayInit(@zOpen,$Size);</>
  <?CLOSE>ArrayInit(@zClose,$Size);</>
  <?HIGH>ArrayInit(@zHigh,$Size);</>
  <?LOW>ArrayInit(@zLow,$Size);</>
  <?VOLUME>ArrayInit(@zVolume,$Size);</>
  <?TIME>ArrayInit(@zTime, $Size);</>

  <?LastTime>
  @shift = iBarShift(NULL,0,"$LastTime");
  <~>
  @shift = $Shift;
  </>
  <?Trace>
  @shift += trace_index;
  </>

  <?indicator>
  <?OPEN>ArrayCopy(@zOpen, Open, 0, Bars-$Size-@shift, $Size);</>
  <?CLOSE>ArrayCopy(@zClose, Close, 0, Bars-$Size-@shift, $Size);</>
  <?HIGH>ArrayCopy(@zHigh, High, 0, Bars-$Size-@shift, $Size);</>
  <?LOW>ArrayCopy(@zLow, Low, 0, Bars-$Size-@shift, $Size);</>
  <?VOLUME>ArrayCopy(@zVolume, Volume, 0, Bars-$Size-@shift, $Size);</>
  <?TIME>ArrayCopy(@zTime, Time, 0, Bars-$Size-@shift, $Size);</>
  <~>
  <?OPEN>
  for (int i=0; i<$Size; i++)
    @zOpen[i] = i<@shift||$Size-1-i+@shift>=Bars?0:Bar.Open($Size-1-i+@shift);
  </>
  <?CLOSE>
  for (int i=0; i<$Size; i++)
    @zClose[i] = i<@shift||$Size-1-i+@shift>=Bars?0:Bar.Close($Size-1-i+@shift);
  </>
  <?HIGH>
  for (int i=0; i<$Size; i++)
    @zHigh[i] = i<@shift||$Size-1-i+@shift>=Bars?0:Bar.High($Size-1-i+@shift);
  </>
  <?LOW>
  for (int i=0; i<$Size; i++)
    @zLow[i] = i<@shift||$Size-1-i+@shift>=Bars?0:Bar.Low($Size-1-i+@shift);
  </>
  <?VOLUME>
  for (int i=0; i<$Size; i++)
    @zVolume[i] = i<@shift||$Size-1-i+@shift>=Bars?0:Bar.RealVolume($Size-1-i+@shift);
  </>
  <?TIME>
  for (int i=0; i<$Size; i++)
    @zTime[i] = i<@shift||$Size-1-i+@shift>=Bars?0:Bar.Time($Size-1-i+@shift);
  </>
  </>

[Help]
Подготавливает буфера со всеми сериями
