[Main]
Title=Вызов индикатора
Group=Индикатор
Name=iCustom

[Property]
Symbol=s,,имя символа
TimeFrame=n,0
Name=s
Pars=s,,параметры индикатора
BufferIndex=n,0
Shift=n,0,cдвиг индикатора относительно ценового графика
Count=n,1,количество извлекаемых значений (если не указано - на выходе значение вместо серии)

[Input]

[Output]
out=row

[InputPars]
Trace

[OutputPars]
Start=0
Size=$Count

[Code]
<gvars>
int handle$out;
double $out<?Count>[]</>;

<init>
  handle$out = iCustom(<?Symbol>"$Symbol"<~>NULL</>, $TimeFrame, "$Name"<?Pars>, $Pars</>);
  if (handle$out == INVALID_HANDLE)
  {
    Print("Индикатор "+"$Name"+" не найден");
    return (INIT_FAILED);
  }

<lines>
  <?Count>
  ArrayInit($out, $Count);
  double @ind[];
  CopyBuffer(handle$out, $BufferIndex, $Shift<?Trace>+trace_index</>, $Count, @ind);
  <?!Count=1>
  for (int n=$Count-1; n>=0; n--)
    $out[n] = @ind[$Count-1-@n];
  <~>
  $out[0] = @ind[0];
  </>
  <~>
  double @ind[];
  CopyBuffer(handle$out, $BufferIndex, $Shift<?Trace>+trace_index</>, 1, @ind);
  $out = @ind[0];
  <?debug>Print("$name = ",$out);</>
  </>

[Help]
Вызов пользовательского индикатора