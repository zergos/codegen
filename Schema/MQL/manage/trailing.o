[Main]
Name=Trailing
Title=Трейлинг
Group=Управление

[Property]
Level=n,100,уровень стопа в пунктах

[Input]
Ticket=n

[Output]
Close=c

[Code]
<lines>
  if (OrderSelect($Ticket, SELECT_BY_TICKET, MODE_TRADES) && OrderCloseTime()==0)
  {
    if (OrderType()==OP_BUY)
    {
      if (Ask-$Level*Point > OrderOpenPrice()-(Ask-Bid) && Ask-$Level*Point > OrderStopLoss())
        OrderModify($Ticket, 0, Ask-$Level*Point, OrderTakeProfit(), 0, 0);
    }
    else if (OrderType()==OP_SELL)
    {
      if (Bid+$Level*Point < OrderOpenPrice()+(Ask-Bid) && Bid+$Level*Point < OrderStopLoss())
        OrderModify($Ticket, 0, Bid+$Level*Point, OrderTakeProfit(), 0, 0);
    }
  }
  else
  {
$Close.lines
  }

[Help]
Скользящий стоп.

